<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Keel's privacy manifest. It declares what the framework itself does, which is:
      UserDefaults for the telemetry dedup state and opt-out (a declared-reason API),
      and no tracking, no tracking domains, and no collected data types that identify
      anyone. The ping payload is counters only — see docs/PRIVACY.md, whose claims
      this manifest mirrors.

      "Product Interaction" with linkage=false, tracking=false covers the anonymous
      launch counters (App Functionality / Analytics). If your app's own collection
      goes beyond Keel's, extend your app-level manifest, not this one.
    -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- CA92.1: access info from same app, per Apple's declared reasons. -->
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
